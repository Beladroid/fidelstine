---
layout: layouts/base.njk
title: Admin
pageClass: admin
permalink: /admin/
noindex: true
eleventyExcludeFromCollections: true
---
<link rel="stylesheet" href="/css/admin.css?v={{ site.buildTime }}">
<section class="section mood-light admin" data-admin>
  <div class="wrap">
    <form class="stats-editor admin-login" data-admin-login hidden novalidate>
      <p class="eyebrow">Staff only</p>
      <h1 style="font-size:var(--step-3)">Sign in</h1>
      <div class="field"><label for="login-name">Your name</label><input id="login-name" name="name" autocomplete="name" maxlength="40" required></div>
      <div class="field"><label for="login-password">Staff password</label><input id="login-password" name="password" type="password" autocomplete="current-password" required></div>
      <button class="btn btn--primary" type="submit">Sign in</button>
      <p class="form-status" data-login-status role="status" aria-live="polite"></p>
    </form>

    <div data-admin-app>
    <div class="admin__head">
      <div>
        <p class="eyebrow">Staff only</p>
        <h1 style="font-size:var(--step-4)">Staff dashboard</h1>
        <p class="muted"><span data-admin-user>Checking your sign-in…</span> <button class="content-admin__reset" type="button" data-admin-logout hidden>Sign out</button></p>
      </div>
      <div class="admin__tabs" role="tablist">
        <button class="chip is-active" role="tab" aria-selected="true" data-tab="donations">Donations</button>
        <button class="chip" role="tab" aria-selected="false" data-tab="gift">Record a donation</button>
        <button class="chip" role="tab" aria-selected="false" data-tab="content">Site content</button>
        <button class="chip" role="tab" aria-selected="false" data-tab="stats">Impact numbers</button>
        <button class="chip" role="tab" aria-selected="false" data-tab="newsletter">Subscribers</button>
        <button class="chip" role="tab" aria-selected="false" data-tab="messages">Messages</button>
      </div>
    </div>

    <p class="form-error" data-admin-error role="alert" hidden></p>

    <div data-panel="donations">
      <form class="admin__filters" data-admin-filters>
        <div class="field"><label for="f-status">Status</label>
          <select id="f-status" name="status"><option value="successful">Successful</option><option value="">All</option><option value="pending">Pending</option><option value="failed">Failed</option><option value="abandoned">Abandoned</option></select></div>
        <div class="field"><label for="f-currency">Currency</label>
          <select id="f-currency" name="currency"><option value="">All</option>{% for code, cur in money.currencies %}<option>{{ code }}</option>{% endfor %}</select></div>
        <div class="field"><label for="f-campaign">Campaign</label>
          <select id="f-campaign" name="campaign"><option value="">All</option>{% for slug, camp in money.campaigns %}<option value="{{ slug }}">{{ camp.title }}</option>{% endfor %}</select></div>
        <div class="field"><label for="f-from">From</label><input id="f-from" type="date" name="from"></div>
        <div class="field"><label for="f-to">To</label><input id="f-to" type="date" name="to"></div>
        <div class="field"><label for="f-q">Search</label><input id="f-q" type="search" name="q" placeholder="Name, email or reference"></div>
        <div class="admin__filter-actions">
          <button class="btn btn--navy" type="submit">Apply</button>
          <a class="btn btn--outline" href="#" data-admin-csv>{% icon "download" %}Export CSV</a>
        </div>
      </form>

      <p class="admin-alert" data-admin-reports hidden></p>
      <div class="admin__totals" data-admin-totals></div>

      <div class="admin__table-wrap">
        <table class="admin__table">
          <thead><tr><th>Date</th><th>Donor</th><th>Amount</th><th>Campaign</th><th>Method</th><th>Status</th><th>Reference</th></tr></thead>
          <tbody data-admin-rows><tr><td colspan="7" class="muted">Loading…</td></tr></tbody>
        </table>
      </div>
      <div class="admin__pager"><button class="btn btn--outline btn--sm" type="button" data-admin-more hidden>Load more</button></div>
    </div>

    <div data-panel="gift" hidden>
      <form class="stats-editor gift-form" data-gift-form novalidate>
        <p class="muted">Record a donation that arrived by bank transfer, PayPal or cash, so it counts in the totals, the export and the Christmas Scheme progress bar. If you add the donor's email, they get a thank-you email.</p>
        <div class="gift-form__grid">
          <div class="field"><label for="g-amount">Amount received</label><input id="g-amount" name="amount" type="number" min="0" step="any" inputmode="decimal" required></div>
          <div class="field"><label for="g-currency">Currency</label>
            <select id="g-currency" name="currency">{% for code, cur in money.currencies %}<option value="{{ code }}">{{ code }} {{ cur.symbol }}</option>{% endfor %}</select></div>
          <div class="field"><label for="g-method">Received by</label>
            <select id="g-method" name="method"><option>GTBank transfer</option><option>PayPal</option><option>Cash</option><option>Other</option></select></div>
          <div class="field"><label for="g-date">Date received</label><input id="g-date" name="date" type="date" required></div>
          <div class="field"><label for="g-campaign">For</label>
            <select id="g-campaign" name="campaign">{% for slug, camp in money.campaigns %}<option value="{{ slug }}">{{ camp.title }}</option>{% endfor %}</select></div>
          <div class="field"><label for="g-name">Donor name <span class="hint">optional</span></label><input id="g-name" name="name" maxlength="120" autocomplete="off"></div>
          <div class="field"><label for="g-email">Donor email <span class="hint">optional</span></label><input id="g-email" name="email" type="email" maxlength="160" autocomplete="off"></div>
          <div class="field"><label for="g-reference">Bank or PayPal reference <span class="hint">optional</span></label><input id="g-reference" name="reference" maxlength="80" autocomplete="off"></div>
          <div class="field gift-form__wide"><label for="g-note">Note <span class="hint">optional</span></label><input id="g-note" name="note" maxlength="300" autocomplete="off"></div>
        </div>
        <label class="check"><input type="checkbox" name="anonymous" value="1">The donor asked to stay anonymous</label>
        <label class="check"><input type="checkbox" name="thank" value="1" checked>Send a thank-you email (if there is an email address)</label>
        <div class="admin__filter-actions">
          <button class="btn btn--primary" type="submit">Record donation</button>
          <span class="form-status" data-gift-status role="status" aria-live="polite"></span>
        </div>
      </form>
    </div>

    <div data-panel="content" hidden>
      <div class="content-admin">
        <nav class="content-admin__nav" aria-label="Site content sections" data-content-nav><p class="muted">Loading…</p></nav>
        <form class="stats-editor content-admin__editor" data-content-form novalidate>
          <p class="muted">Choose a section to edit.</p>
        </form>
      </div>
    </div>

    <div data-panel="newsletter" hidden>
      <div class="admin__filter-actions" style="margin-bottom:1rem"><a class="btn btn--outline" href="/api/admin/newsletter?format=csv">{% icon "download" %}Export CSV</a></div>
      <div class="admin__table-wrap"><table class="admin__table"><thead><tr><th>Date</th><th>Email</th><th>Source</th></tr></thead><tbody data-admin-newsletter></tbody></table></div>
    </div>

    <div data-panel="stats" hidden>
      <form class="stats-editor" data-stats-form>
        <p class="muted">These are the figures in the "Our impact" row on the home page. Changes show on the live site within a minute.</p>
        <div class="stats-editor__rows" data-stats-rows><p class="muted">Loading…</p></div>
        <div class="admin__filter-actions">
          <button class="btn btn--primary" type="submit">Save numbers</button>
          <span class="form-status" data-stats-status role="status" aria-live="polite"></span>
        </div>
      </form>
    </div>

    <div data-panel="messages" hidden>
      <div class="admin__table-wrap"><table class="admin__table"><thead><tr><th>Date</th><th>From</th><th>About</th><th>Message</th></tr></thead><tbody data-admin-messages></tbody></table></div>
    </div>
    </div>
  </div>
</section>
