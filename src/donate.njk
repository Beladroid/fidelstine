---
layout: layouts/base.njk
title: Donate
hasHero: true
pageClass: donate
permalink: /donate/
description: Give to Fidelstine Charity Concerns and Orphanage by bank transfer or PayPal, from Nigeria or anywhere in the world.
---
{%- import "macros/components.njk" as c with context -%}
{%- set pool = media.items | tagged("gallery") | ofType("image") -%}

{%- set heroLead = "Give once, in the currency that suits you. It takes about a minute, and Flutterwave keeps your payment secure." if site.onlineGiving else "Give by bank transfer in Nigeria, or by PayPal from anywhere in the world. Online card payments are coming soon." %}
{{ c.pageHero("Every gift restores a little more dignity", "Donate", heroLead, "school-bag-handover", false, "Donate") }}

<section class="section mood-light donate-page" id="donate" aria-labelledby="give-title">
  <div class="wrap donate-layout donate-layout--form-first">
    <div class="donate-card" data-reveal>
      {%- if site.onlineGiving %}
      <h2 id="give-title" class="donate-card__title">Make a gift</h2>
      <p class="donate-card__sub">Choose an amount and where it should go.</p>
      {{ c.donateForm("page", false, "general") }}
      {%- else %}
      {{ c.manualGiving(false, "h2", "give-title") }}
      {%- endif %}
    </div>

    <div class="donate-intro" data-reveal="right">
      <p class="eyebrow">What your gift does</p>
      <h2 class="reveal-words" data-split style="font-size:var(--step-3)">Real help for real children</h2>
      <ul class="impact-list" role="list">
        {%- for g in copy.giftImpact.NGN %}
        <li>
          <span class="impact-list__thumb">{% if pool[loop.index0] %}{{ c.pic(pool[loop.index0], "64px") }}{% endif %}</span>
          <span><strong data-money-ngn="{{ g.amount }}" data-gi-amount="{{ loop.index0 }}">{{ g.amount | money("NGN") }}</strong><span data-gi-text="{{ loop.index0 }}">{{ g.text }}</span></span>
        </li>
        {%- endfor %}
      </ul>
      <div style="margin-top:var(--space-7)">
        <p class="eyebrow">Christmas Scheme</p>
        {{ c.progress("christmas-scheme", true) }}
      </div>
    </div>
  </div>
</section>

{%- if site.onlineGiving %}
<section class="section section--tight mood-white" aria-labelledby="manual-title">
  <div class="wrap">
    {{ c.manualGiving(false, "h2", "manual-title") }}
  </div>
</section>
{%- endif %}

<section class="section mood-light" aria-labelledby="faq-title">
  <div class="wrap wrap--narrow">
    {{ c.sectionHead("Questions", "Giving, answered", "", false, false, null, "faq-title") }}
    {%- set wanted = "online" if site.onlineGiving else "manual" %}
    <div class="faq" data-live="faqs" data-online="{{ 'true' if site.onlineGiving else 'false' }}">
      {%- for f in copy.faqs | selectattr("show", "in", ["always", wanted]) %}
      <details{% if loop.first %} open{% endif %}><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>
      {%- endfor %}
    </div>
    <p class="muted" style="margin-top:var(--space-5); font-size:var(--step--1)">Read our <a class="text-link" href="/donation-policy/">donation policy</a> and <a class="text-link" href="/privacy/">privacy policy</a>.</p>
  </div>
</section>
