---
layout: layouts/base.njk
title: Contact us
hasHero: true
pageClass: contact
permalink: /contact/
description: Contact Fidelstine Charity Concerns and Orphanage in Ubulu Okiti, Delta State, Nigeria. Phone, WhatsApp, address and message form.
---
{%- import "macros/components.njk" as c with context -%}

{% call c.pageHero("We would love to hear from you", "Contact", "Questions about giving, volunteering, partnering or visiting. Call, send a WhatsApp message or write to us below.", "welcome-at-school", false, "Contact") %}
  <a class="btn btn--primary btn--lg" href="tel:{{ site.phonesNigeria[0].tel }}" data-live-call>{% icon "phone" %}Call us</a>
  <span class="live-group" data-live="wa-buttons">{% for w in site.whatsappList %}<a class="btn btn--lg whatsapp-btn" href="https://wa.me/{{ w.number }}" target="_blank" rel="noopener">{% icon "whatsapp" %}WhatsApp {{ w.country }}</a>{% endfor %}</span>
{% endcall %}

<section class="section mood-light" aria-labelledby="reach-title">
  <div class="wrap contact-grid">
    <div class="stack" style="--stack:1.2rem">
      <h2 id="reach-title" class="visually-hidden">How to reach us</h2>
      <div class="contact-cards" data-stagger>
        <div class="contact-card"><span class="c-ico">{% icon "pin" %}</span><div><h3>{{ site.addresses.head.label }}</h3><address>{{ site.addresses.head.lines }}</address><a href="{{ site.addresses.head.map }}" target="_blank" rel="noopener">Get directions</a></div></div>
        <div class="contact-card"><span class="c-ico">{% icon "globe" %}</span><div><h3>{{ site.addresses.international.label }}</h3><address>{{ site.addresses.international.lines }}</address><a href="{{ site.addresses.international.map }}" target="_blank" rel="noopener">Get directions</a></div></div>
        <div class="contact-card"><span class="c-ico">{% icon "pin" %}</span><div><h3>{{ site.addresses.extension.label }}</h3><address>{{ site.addresses.extension.lines }}</address></div></div>
        <div class="contact-card"><span class="c-ico">{% icon "phone" %}</span><div><h3>Nigeria</h3><span class="live-group" data-live="phones-ng">{% for p in site.phonesNigeria %}<a href="tel:{{ p.tel }}">{{ p.display }}</a>{% endfor %}</span></div></div>
        <div class="contact-card"><span class="c-ico">{% icon "globe" %}</span><div><h3>International</h3><span class="live-group" data-live="phones-intl">{% for p in site.phonesInternational %}<a href="tel:{{ p.tel }}">{{ p.display }}</a>{% endfor %}</span></div></div>
        <div class="contact-card"><span class="c-ico">{% icon "whatsapp" %}</span><div><h3>WhatsApp</h3><span class="live-group" data-live="wa-lines">{% for w in site.whatsappList %}<a href="https://wa.me/{{ w.number }}" target="_blank" rel="noopener">{{ w.display }}{% if w.country %} ({{ w.country }}){% endif %}</a>{% endfor %}</span></div></div>
        <div class="contact-card"><span class="c-ico">{% icon "mail" %}</span><div><h3>Email</h3><span class="live-group" data-live="email" data-variant="contact">{% if site.email %}<a href="mailto:{{ site.email }}">{{ site.email }}</a>{% else %}<p>Please use the form and we will reply by email.</p>{% endif %}</span></div></div>
        <div class="contact-card"><span class="c-ico">{% icon "instagram" %}</span><div><h3>Social</h3><span class="live-group" data-live="social-lines">{% for s in site.socials %}{% if s.url %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.name }}: {{ s.handle }}</a>{% endif %}{% endfor %}</span></div></div>
      </div>
      <div class="map-embed" data-reveal>
        <div class="map-embed__load">
          {% icon "pin" %}
          <p>The map loads only when you ask for it, to save your data.</p>
          <button class="btn btn--ghost" type="button" data-map-load="{{ site.addresses.head.embed }}">Show map</button>
        </div>
      </div>
    </div>

    <form class="form-card" data-contact-form novalidate data-reveal="right">
      <h2 style="font-size:var(--step-3)">Send a message</h2>
      <div class="field-grid field-grid--2">
        <div class="field"><label for="c-name">Your name</label><input id="c-name" name="name" autocomplete="name" required maxlength="120"></div>
        <div class="field"><label for="c-email">Email</label><input id="c-email" type="email" name="email" autocomplete="email" required maxlength="160"></div>
        <div class="field"><label for="c-phone">Phone <span class="hint">optional</span></label><input id="c-phone" type="tel" name="phone" autocomplete="tel" maxlength="30"></div>
        <div class="field"><label for="c-subject">About</label>
          <select id="c-subject" name="subject">
            <option>General question</option><option>Giving and donations</option><option>Volunteering</option><option>Partnership</option><option>Visiting the home</option><option>Media and press</option>
          </select></div>
        <div class="field field--full"><label for="c-message">Message</label><textarea id="c-message" name="message" required minlength="10" maxlength="3000" rows="6"></textarea></div>
      </div>
      <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button class="btn btn--primary btn--lg" type="submit">Send message {% icon "arrow", "i--arrow" %}</button>
      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
      <p class="muted" style="font-size:var(--step--2)">We use your details only to reply to you. See our <a class="text-link" href="/privacy/">privacy policy</a>.</p>
    </form>
  </div>
</section>
