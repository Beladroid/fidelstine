# Copy to .dev.vars for local development (never commit .dev.vars).
# Flutterwave TEST keys from dashboard.flutterwave.com > Settings > API keys (toggle "Test mode")
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
# Any long random string; set the same value in Flutterwave > Settings > Webhooks > Secret hash
FLW_SECRET_HASH=replace-with-a-long-random-string

# Leave SITE_URL empty locally so links use http://localhost:8788
SITE_URL=

# Optional: thank-you and staff emails through Resend
RESEND_API_KEY=
MAIL_FROM=Fidelstine <donations@your-domain.org>
STAFF_EMAIL=

# Admin page: allow localhost without Cloudflare Access while developing
ADMIN_DEV_BYPASS=1
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ADMIN_EMAILS=

# Salt for hashing IPs in the rate limiter
RATE_SALT=change-me
