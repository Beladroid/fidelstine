{
  "name": "fidelstine",
  "version": "3.0.0",
  "private": true,
  "description": "Website for Fidelstine Charity Concerns and Orphanage",
  "type": "module",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "dev": "concurrently -k -n site,api -c blue,magenta \"eleventy --watch\" \"wrangler pages dev _site --port 8788\"",
    "db:migrate:local": "wrangler d1 migrations apply fidelstine --local",
    "db:migrate:remote": "wrangler d1 migrations apply fidelstine --remote",
    "media": "node scripts/add-media.mjs",
    "media:report": "node scripts/media-report.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "test:unit": "node --test tests/unit.test.mjs",
    "shots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "concurrently": "^9.2.1",
    "ffmpeg-static": "^5.2.0",
    "puppeteer-core": "^25.12.0",
    "wrangler": "^4.40.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "sharp@0.35.4": true,
    "sharp@0.33.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true
  }
}
